# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
release/

# Environment variables (contain secrets - never commit)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# DB sync backups (contain data dumps)
scripts/.backup/

# Local verification logs (created by scripts/*verify*.ps1)
verify-logs/
npm-test.log
npmtest2.log
husky-check.txt

# Generated husky hooks (regenerated by `npm install` via husky prepare)
.husky/_

# IDE / editor files
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

