# Database — Cloud (Aiven MySQL, primary)
DB_HOST=your-database-host.aivencloud.com
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=defaultdb
DB_PORT=28067
DB_SSL=true

# Database — Local XAMPP/MariaDB (hot standby)
DB_HOST_2=127.0.0.1
DB_PORT_2=3306
DB_USER_2=root
DB_PASSWORD_2=
DB_SSL_2=false
# DB_PREFER=cloud  → try cloud first, local is hot standby (default)
# DB_PREFER=local  → try local first, cloud is hot standby

# Legacy cloud vars (used as fallback if DB_HOST etc are unset)
# DB_CLOUD_HOST=your-database-host.aivencloud.com
# DB_CLOUD_USER=your-db-user
# DB_CLOUD_PASSWORD=your-db-password
# DB_CLOUD_PORT=28067

# Server
PORT=3001
NODE_ENV=development

# Auth / secrets
JWT_SECRET=your-jwt-secret
ADMIN_SESSION_SECRET=your-session-secret
ADMIN_CODE=your-admin-code

# Frontend
FRONTEND_URL=http://localhost:5173
