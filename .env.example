# =============================================
# The Greggory Systems — Environment Variables
# =============================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# ---------------------------------------------
# Auth Secrets (REQUIRED)
# ---------------------------------------------
JWT_SECRET=your-jwt-secret-min-32-chars-long
ADMIN_SESSION_SECRET=your-admin-session-secret-min-32-chars

# ---------------------------------------------
# Cloud Database (Aiven / Production)
# ---------------------------------------------
DB_HOST=your-cloud-db-host.example.com
DB_PORT=28067
DB_USER=avnadmin
DB_PASSWORD=your-cloud-db-password
DB_NAME=the_greggory_systems_and_strategy_firm_db_main
DB_SSL=true

# ---------------------------------------------
# Local Database (XAMPP / Development)
# ---------------------------------------------
DB_HOST_2=127.0.0.1
DB_PORT_2=3306
DB_USER_2=root
DB_PASSWORD_2=

# ---------------------------------------------
# DB Connection Priority
# ---------------------------------------------
# "cloud" = try Aiven first, fallback to XAMPP (production)
# "local" = try XAMPP first, fallback to Aiven (offline dev)
DB_PREFER=cloud

# ---------------------------------------------
# M-Pesa Payment Gateway (Safaricom)
# ---------------------------------------------
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_PASSKEY=your-mpesa-passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# ---------------------------------------------
# API / Frontend
# ---------------------------------------------
VITE_API_BASE_URL=
ADMIN_KEY=your-admin-access-key
PORT=5000
NODE_ENV=development

