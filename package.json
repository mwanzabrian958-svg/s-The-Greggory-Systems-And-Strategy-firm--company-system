{
  "name": "greggory-systems-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/start-dev.cjs",
    "dev:old": "concurrently \"npm run backend\" \"vite\"",
    "predev": "node scripts/clear-ports.cjs",
    "vite": "vite",
    "ports:clear": "node scripts/clear-ports.cjs",
    "predesktop": "node scripts/clear-ports.cjs",
    "backend": "node server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "desktop": "cross-env NODE_ENV=development concurrently \"npm run backend\" \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start": "npm run desktop"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/typography": "^0.5.20",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.0.0",
    "cors": "^2.8.6",
    "daisyui": "^4.12.24",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^10.12.16",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.263.1",
    "mysql2": "^3.24.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^1.14.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^25.3.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "wait-on": "^7.0.1"
  }
}
